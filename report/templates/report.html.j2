<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('report_title') }} · {{ project_name }}</title>
<style>
{{ font_faces }}

/* ═══════════ Tokens ═══════════ */
:root {
  color-scheme: light;
  --bg: #f4f5f7;
  --surface: #ffffff;
  --surface-2: #f7f8fa;
  --border: #e3e5e9;
  --border-strong: #cfd3da;
  --text: #0f1115;
  --text-2: #4a4e57;
  --text-3: #7d828c;
  --accent: #2a78d6;
  --accent-soft: #e8f1fc;
  --track: #e9eaed;
  --code-bg: #f7f8fa;
  --code-hl: #fff4e0;
  --code-hl-border: #fab219;

  --critical: #d03b3b;  --critical-soft: #fbeaea;
  --serious:  #ec835a;  --serious-soft:  #fdf0ea;
  --warning:  #fab219;  --warning-soft:  #fef6e2;
  --low:      #8a909a;  --low-soft:      #f0f1f3;
  --good:     #0ca30c;  --good-soft:     #e7f6e7;

  --radius: 10px;
  --shadow: 0 1px 2px rgba(15, 17, 21, .04), 0 2px 8px rgba(15, 17, 21, .04);
  --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
}
{% if mode == 'screen' %}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #111214; --surface: #1a1b1d; --surface-2: #212225; --border: #2e3034; --border-strong: #3d4045;
    --text: #f0f1f3; --text-2: #c2c5cc; --text-3: #8d919a;
    --accent: #3987e5; --accent-soft: #1d2a3b; --track: #2c2e32;
    --code-bg: #15161a; --code-hl: #3a2e14; --code-hl-border: #c98500;
    --critical-soft: #3a1f1f; --serious-soft: #3a261d; --warning-soft: #3a3016; --low-soft: #26282c; --good-soft: #17301a;
    --shadow: none;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111214; --surface: #1a1b1d; --surface-2: #212225; --border: #2e3034; --border-strong: #3d4045;
  --text: #f0f1f3; --text-2: #c2c5cc; --text-3: #8d919a;
  --accent: #3987e5; --accent-soft: #1d2a3b; --track: #2c2e32;
  --code-bg: #15161a; --code-hl: #3a2e14; --code-hl-border: #c98500;
  --critical-soft: #3a1f1f; --serious-soft: #3a261d; --warning-soft: #3a3016; --low-soft: #26282c; --good-soft: #17301a;
  --shadow: none;
}
{% endif %}

/* ═══════════ Base ═══════════ */
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 400 14px/1.5 var(--sans);
  font-feature-settings: "cv11", "ss01";
}
h1, h2, h3 { margin: 0; font-weight: 600; letter-spacing: -0.01em; }
h2 { font-size: 18px; }
h3 { font-size: 14px; }
p { margin: 0; }
code, .mono, .code { font-family: var(--mono); font-size: 12.5px; font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0; }
.icon { width: 16px; height: 16px; flex: none; vertical-align: -3px; }
.muted { color: var(--text-3); }
.secondary { color: var(--text-2); }
.num { font-variant-numeric: tabular-nums; }

.page { max-width: 1120px; margin: 0 auto; padding: 24px 20px 48px; }
.section { margin-top: 28px; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; flex-wrap: wrap; }
.section-head h2 { flex: none; white-space: nowrap; }
.section-head p { color: var(--text-3); font-size: 13px; max-width: 640px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; }
.card-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 14px; }
.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
.actions-card { margin-top: 16px; }

/* ═══════════ Masthead ═══════════ */
.masthead { background: var(--surface); border-bottom: 1px solid var(--border); }
.masthead-inner { max-width: 1120px; margin: 0 auto; padding: 18px 20px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 12px; }
.logo { width: 38px; height: 38px; border-radius: 9px; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; }
.logo .icon { width: 22px; height: 22px; }
.brand-name { font-weight: 700; font-size: 16px; letter-spacing: -0.02em; }
.brand-sub { font-size: 12px; color: var(--text-3); }
.meta { display: flex; gap: 24px; flex-wrap: wrap; margin-left: auto; }
.meta div { display: flex; flex-direction: column; }
.meta dt { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-3); }
.meta dd { margin: 0; font-weight: 500; font-size: 13px; }
.toolbar-buttons { display: flex; gap: 8px; }
.btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); font: 500 13px var(--sans); cursor: pointer; }
.btn:hover { background: var(--surface-2); }

/* ═══════════ Severity system ═══════════ */
.sev-CRITICA { --sev: var(--critical); --sev-soft: var(--critical-soft); }
.sev-ALTA    { --sev: var(--serious);  --sev-soft: var(--serious-soft); }
.sev-MEDIA   { --sev: var(--warning);  --sev-soft: var(--warning-soft); }
.sev-BAJA    { --sev: var(--low);      --sev-soft: var(--low-soft); }
.lvl-critical { --sev: var(--critical); --sev-soft: var(--critical-soft); }
.lvl-serious  { --sev: var(--serious);  --sev-soft: var(--serious-soft); }
.lvl-warning  { --sev: var(--warning);  --sev-soft: var(--warning-soft); }
.lvl-good     { --sev: var(--good);     --sev-soft: var(--good-soft); }
.badge { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px 2px 6px; border-radius: 999px; background: var(--sev-soft); color: var(--text); font-size: 12px; font-weight: 600; white-space: nowrap; }
.badge .icon { width: 14px; height: 14px; color: var(--sev); }
.chip { display: inline-flex; align-items: center; padding: 1px 7px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface-2); color: var(--text-2); font-size: 11.5px; font-weight: 500; white-space: nowrap; }
.dot { width: 8px; height: 8px; border-radius: 2px; background: var(--sev); display: inline-block; flex: none; }

/* ═══════════ Executive summary ═══════════ */
.exec { display: grid; grid-template-columns: 340px 1fr; gap: 16px; }
.risk-card { display: flex; flex-direction: column; align-items: center; text-align: center; }
.gauge-wrap { position: relative; width: 220px; }
.gauge { width: 100%; display: block; }
.gauge-track { stroke: var(--track); }
.gauge-value { position: absolute; left: 0; right: 0; bottom: 2px; }
.gauge-value strong { display: block; font-size: 44px; line-height: 1; font-weight: 700; letter-spacing: -0.03em; }
.gauge-value span { font-size: 12px; color: var(--text-3); }
.verdict { margin-top: 16px; padding: 12px 14px; border-radius: 8px; background: var(--sev-soft); border-left: 3px solid var(--sev); text-align: left; width: 100%; }
.verdict-title { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.verdict-title .icon { color: var(--sev); width: 18px; height: 18px; }
.verdict p { margin-top: 4px; font-size: 13px; color: var(--text-2); }
.help { margin-top: 12px; font-size: 11.5px; color: var(--text-3); }

.tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.tile { border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; background: var(--surface); }
.tile-label { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-2); font-weight: 500; }
.tile-label .icon { color: var(--sev); width: 15px; height: 15px; }
.tile-value { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; margin-top: 4px; line-height: 1.1; }
.stack { display: flex; gap: 2px; height: 12px; margin-top: 18px; }
.stack .seg { background: var(--sev); min-width: 4px; }
.stack .seg:first-child { border-radius: 4px 0 0 4px; }
.stack .seg:last-child { border-radius: 0 4px 4px 0; }
.stack .seg:only-child { border-radius: 4px; }
.stack.empty { background: var(--track); border-radius: 4px; }
.split { display: flex; gap: 20px; margin-top: 14px; font-size: 12.5px; color: var(--text-2); flex-wrap: wrap; }
.split strong { color: var(--text); }

/* ═══════════ Tables ═══════════ */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); padding: 0 12px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; }
td { padding: 11px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
tr:last-child td { border-bottom: 0; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
.action-title { font-weight: 600; }
.action-why { color: var(--text-3); font-size: 12.5px; margin-top: 2px; }
.rank { width: 26px; height: 26px; border-radius: 7px; background: var(--surface-2); border: 1px solid var(--border); display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 12px; }
.effort { font-size: 12px; font-weight: 500; white-space: nowrap; }
.effort-bars { display: inline-flex; gap: 2px; margin-right: 6px; vertical-align: 1px; }
.effort-bars i { width: 4px; height: 10px; border-radius: 1px; background: var(--track); display: block; }
.effort-bars i.on { background: var(--text-2); }

/* ═══════════ Bar charts ═══════════ */
.bars { display: flex; flex-direction: column; gap: 10px; }
.bar-row { display: grid; grid-template-columns: minmax(120px, 38%) 1fr 36px; gap: 10px; align-items: center; font-size: 12.5px; }
.bar-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-2); }
.bar-track { height: 10px; display: flex; gap: 2px; }
.bar-fill { background: var(--accent); border-radius: 0 4px 4px 0; min-width: 3px; }
.bar-track .seg { background: var(--sev); min-width: 3px; }
.bar-track .seg:last-child { border-radius: 0 4px 4px 0; }
.bar-value { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
.legend { display: flex; gap: 14px; margin-top: 14px; font-size: 12px; color: var(--text-2); flex-wrap: wrap; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }

/* ═══════════ Threats ═══════════ */
.threat-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
.ip { font-family: var(--mono); font-size: 12.5px; font-weight: 600; }
.types { display: flex; gap: 4px; flex-wrap: wrap; }

/* ═══════════ Findings ═══════════ */
.filters { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
.search { flex: 1 1 240px; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--surface); color: var(--text-3); }
.search input { border: 0; outline: 0; background: transparent; color: var(--text); font: 13px var(--sans); width: 100%; }
.seg-filter { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 8px; overflow: hidden; }
.seg-filter button { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border: 0; border-right: 1px solid var(--border); background: var(--surface); color: var(--text-2); font: 500 12.5px var(--sans); cursor: pointer; }
.seg-filter button:last-child { border-right: 0; }
.seg-filter button[aria-pressed="true"] { background: var(--accent-soft); color: var(--text); }
select { height: 34px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--surface); color: var(--text); font: 13px var(--sans); padding: 0 8px; }
.count { font-size: 12.5px; color: var(--text-3); margin-left: auto; }

.findings { display: flex; flex-direction: column; gap: 8px; }
.finding { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--sev); border-radius: 8px; }
.finding summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 12px 14px; }
.finding summary::-webkit-details-marker { display: none; }
.finding-title { font-weight: 600; }
.finding-loc { font-family: var(--mono); font-size: 12px; color: var(--text-3); margin-top: 1px; overflow-wrap: anywhere; }
.finding-tags { display: flex; gap: 6px; align-items: center; }
.chev { color: var(--text-3); transition: transform .15s; }
.finding[open] .chev { transform: rotate(180deg); }
.finding-body { padding: 0 14px 14px; display: flex; flex-direction: column; gap: 14px; }
.rf { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.field-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); margin-bottom: 4px; }
.field-text { font-size: 13px; color: var(--text-2); }
.code { background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: 8px 0; font-family: var(--mono); font-size: 12px; line-height: 1.6; overflow-x: auto; }
.code-line { display: flex; white-space: pre; padding: 0 12px 0 0; border-left: 3px solid transparent; }
.code-line.hl { background: var(--code-hl); border-left-color: var(--code-hl-border); }
.code-line .ln { width: 44px; flex: none; text-align: right; padding-right: 12px; color: var(--text-3); user-select: none; }
.meta-line { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; font-size: 12px; color: var(--text-3); }
.empty-state { text-align: center; padding: 40px; color: var(--text-3); }
.empty-state .icon { width: 28px; height: 28px; color: var(--good); }

/* ═══════════ Annex ═══════════ */
.phases { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.phase { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border); font-size: 12.5px; font-weight: 500; }
.phase b { width: 20px; height: 20px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 11px; display: inline-flex; align-items: center; justify-content: center; }
.phase-sep { color: var(--text-3); }
.timeline { list-style: none; margin: 0; padding: 0; }
.timeline li { display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
.timeline li:last-child { border-bottom: 0; }
.step-tool { font-family: var(--mono); font-size: 12.5px; font-weight: 600; }
.step-reason { color: var(--text-2); font-size: 13px; margin-top: 2px; }
.step-stats { text-align: right; font-size: 12px; color: var(--text-3); white-space: nowrap; }
.ok { color: var(--good); } .err { color: var(--critical); }
footer { margin-top: 36px; text-align: center; font-size: 12px; color: var(--text-3); }

@media (max-width: 860px) {
  .exec { grid-template-columns: 1fr; }
  .tiles { grid-template-columns: repeat(2, 1fr); }
  .rf { grid-template-columns: 1fr; gap: 14px; }
  .meta { margin-left: 0; }
}

{% if mode == 'print' %}
/* ═══════════ Print / PDF (WeasyPrint) ═══════════ */
@page {
  size: A4;
  margin: 18mm 14mm 16mm 14mm;
  @top-left { content: "SecScan · {{ project_name | css_string }}"; font-family: 'Inter', sans-serif; font-size: 8pt; font-weight: 500; color: #7d828c; }
  @top-right { content: "{{ t('report_title') }} · {{ generated_at }}"; font-family: 'Inter', sans-serif; font-size: 8pt; color: #7d828c; }
  @bottom-right { content: "{{ t('page') }} " counter(page) " {{ t('of') }} " counter(pages); font-family: 'Inter', sans-serif; font-size: 8pt; color: #7d828c; }
  @bottom-left { content: "{{ t('generated_by') }} v{{ version }}"; font-family: 'Inter', sans-serif; font-size: 8pt; color: #7d828c; }
}
@page :first { @top-left { content: none; } @top-right { content: none; } }
body { background: #fff; font-size: 9pt; line-height: 1.45; }
.page { max-width: none; padding: 0; }
h2 { font-size: 13pt; }
.section { margin-top: 7mm; }
.section-head { break-after: avoid; margin-bottom: 3mm; }
.section-head p { font-size: 8.5pt; }
.break { break-before: page; }
.card { box-shadow: none; padding: 5mm; border-radius: 2.5mm; }
.card-title { margin-bottom: 4mm; font-size: 9pt; }
.card, .finding, tr, .timeline li, .bar-row, .tile { break-inside: avoid; }
.actions-card { break-inside: auto; }

/* Masthead: una sola fila, sin wrap */
.masthead { border: 0; border-bottom: 1.5pt solid var(--text); margin-bottom: 2mm; }
.masthead-inner { padding: 0 0 4mm; max-width: none; flex-wrap: nowrap; gap: 5mm; }
.brand { flex: none; }
.brand-sub, .meta dd, .meta dt { white-space: nowrap; }
.meta { flex-wrap: nowrap; gap: 5mm; margin-left: auto; }
.meta dt { font-size: 6.5pt; letter-spacing: 0; }
.meta dd, .meta dd code { font-size: 8pt; }
.meta .meta-duration, .meta .meta-skill { display: none; }
.effort-bars { display: inline-block; vertical-align: 0; }
.effort-bars i { display: inline-block; margin-right: 1px; }
.phase b { display: inline-block; text-align: center; line-height: 20px; }
.risk-card .card-title { white-space: nowrap; }
td.effort { white-space: nowrap; }
.help { display: none; }
.actions-card table { table-layout: fixed; }
.actions-card th:nth-child(1) { width: 9mm; }
.actions-card th:nth-child(3) { width: 26mm; }
.actions-card th:nth-child(4) { width: 18mm; }
.actions-card th:nth-child(5) { width: 16mm; }
.actions-card th:nth-child(6) { width: 22mm; }
.actions-card td { padding-top: 1.8mm; padding-bottom: 1.8mm; }

/* WeasyPrint: grid limitado y flex/grid cuadrático en contenedores que cruzan páginas.
   En impresión se usan flex con anchos fijos (dentro de una página) o bloques. */
.exec { display: flex; gap: 4mm; }
.exec > .risk-card { width: 64mm; flex: none; }
.exec > .card:last-child { flex: 1; }
.gauge-wrap { width: 50mm; }
.gauge-value strong { font-size: 28pt; }
.verdict { margin-top: 4mm; padding: 3mm; }
.verdict p, .help { font-size: 8pt; }
.tiles, .threat-tiles { display: flex; gap: 3mm; }
.tiles .tile, .threat-tiles .tile { flex: 1; padding: 3mm; }
.tile-value { font-size: 18pt; }
.stack { margin-top: 5mm; }
.actions-card { margin-top: 4mm; }
.action-why { font-size: 8pt; }
.grid-2 { display: flex; gap: 4mm; }
.grid-2 > .card { flex: 1; width: 50%; }
.bars { display: block; }
.bar-row { display: flex; gap: 3mm; margin-bottom: 2.5mm; font-size: 8.5pt; }
.bar-label { width: 42%; flex: none; white-space: normal; overflow: visible; line-height: 1.25; }
.bar-track { flex: 1; height: 3mm; }
.bar-value { width: 8mm; flex: none; }
.timeline { display: block; }
.timeline li { display: flex; gap: 3mm; padding: 3mm 0; }
.timeline li > div:nth-child(2) { flex: 1; }

.findings { display: block; }
.finding { display: block; margin-bottom: 3mm; }
.finding summary { display: flex; gap: 3mm; padding: 3mm 4mm; }
.finding summary > div:nth-child(2) { flex: 1; }
.finding-body { display: block; padding: 0 4mm 4mm; }
.finding-body > div { margin-bottom: 3mm; }
.finding-body > div:last-child { margin-bottom: 0; }
.rf { display: table; width: 100%; table-layout: fixed; }
.rf > div { display: table-cell; padding-right: 5mm; vertical-align: top; }
.rf > div:last-child { padding-right: 0; }
.field-text { font-size: 8.5pt; }
.code { font-size: 7.5pt; overflow: visible; padding: 2mm 0; }
.code-line { white-space: pre-wrap; }
.code-line .ln { width: 10mm; }
td { padding: 2.2mm 2.5mm; }
th { padding: 0 2.5mm 2mm; font-size: 7pt; }
.compact td { font-size: 8pt; }
{% endif %}
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-inner">
    <div class="brand">
      <div class="logo">{{ icon('shield-check') }}</div>
      <div>
        <div class="brand-name">SecScan</div>
        <div class="brand-sub">{{ t('report_title') }}</div>
      </div>
    </div>
    <dl class="meta">
      <div><dt>{{ t('project') }}</dt><dd>{{ project_name }}</dd></div>
      <div><dt>{{ t('date') }}</dt><dd class="num">{{ generated_at }}</dd></div>
      <div class="meta-duration"><dt>{{ t('duration') }}</dt><dd class="num">{{ results.get('total_time_seconds', 0) }} {{ t('seconds') }}</dd></div>
      <div><dt>{{ t('files_analyzed') }}</dt><dd class="num">{{ context.get('total_files', 0) }}</dd></div>
      {% if results.get('skill_used') %}<div class="meta-skill"><dt>{{ t('skill') }}</dt><dd><code>{{ results.skill_used }}</code></dd></div>{% endif %}
    </dl>
    {% if mode == 'screen' %}
    <div class="toolbar-buttons">
      <button class="btn" id="theme-toggle" type="button" title="{{ t('toggle_theme') }}">{{ icon('moon') }}</button>
      <button class="btn" type="button" onclick="window.print()">{{ icon('printer') }} {{ t('print') }}</button>
    </div>
    {% endif %}
  </div>
</header>

<main class="page">

{# ═══════════════════ Resumen ejecutivo ═══════════════════ #}
<section class="section">
  <div class="section-head"><h2>{{ t('executive_summary') }}</h2></div>
  <div class="exec">
    <div class="card risk-card lvl-{{ ins.verdict }}">
      <div class="card-title">{{ icon('activity') }} {{ t('risk_score') }}</div>
      <div class="gauge-wrap">
        {{ gauge(ins.risk_score, ins.verdict) }}
        <div class="gauge-value"><strong class="num">{{ ins.risk_score }}</strong><span>/ 100</span></div>
      </div>
      <div class="verdict">
        <div class="verdict-title">
          {{ icon({'critical': 'octagon-alert', 'serious': 'triangle-alert', 'warning': 'circle-alert', 'good': 'shield-check'}[ins.verdict]) }}
          {{ t('verdict_' ~ ins.verdict) }}
        </div>
        <p>{{ t('verdict_detail_' ~ ins.verdict, n=ins.verdict_n) }}</p>
      </div>
      <p class="help">{{ t('risk_score_help') }}</p>
    </div>

    <div class="card">
      <div class="card-title">{{ icon('bug') }} {{ t('severity_distribution') }} · {{ t('exposure_note') }}</div>
      <div class="tiles">
        {% for sev in SEVERITIES %}
        <div class="tile sev-{{ sev }}">
          <div class="tile-label">{{ icon(SEVERITY_ICON[sev]) }} {{ t('sev_' ~ sev) }}</div>
          <div class="tile-value num">{{ ins.severity_counts[sev] }}</div>
        </div>
        {% endfor %}
      </div>
      {% if ins.exposure_total %}
      <div class="stack" role="img" aria-label="{{ t('severity_distribution') }}">
        {% for sev in SEVERITIES if ins.severity_counts[sev] %}
        <div class="seg sev-{{ sev }}" style="flex: {{ ins.severity_counts[sev] }}" title="{{ t('sev_' ~ sev) }}: {{ ins.severity_counts[sev] }}"></div>
        {% endfor %}
      </div>
      {% else %}
      <div class="stack empty"></div>
      {% endif %}
      <div class="split">
        <span>{{ t('exposure_note') }}: <strong class="num">{{ ins.exposure_total }}</strong></span>
        <span>{{ t('threats_note') }}: <strong class="num">{{ ins.threat_events }}</strong></span>
      </div>
    </div>
  </div>

  <div class="card actions-card">
      <div class="card-title">{{ icon('list-checks') }} {{ t('priority_actions') }} <span class="muted" style="font-weight: 400">· {{ t('priority_actions_help') }}</span></div>
      {% if ins.actions %}
      <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>{{ t('col_action') }}</th><th>{{ t('col_severity') }}</th><th class="n">{{ t('col_findings') }}</th><th class="n">{{ t('col_files') }}</th><th>{{ t('col_effort') }}</th></tr></thead>
        <tbody>
        {% for a in ins.actions %}
        <tr>
          <td><span class="rank">{{ loop.index }}</span></td>
          <td><div class="action-title">{{ t('action_' ~ a.key) }}</div><div class="action-why">{{ t('action_' ~ a.key ~ '_why') }}</div></td>
          <td><span class="badge sev-{{ a.max_severity }}">{{ icon(SEVERITY_ICON[a.max_severity]) }} {{ t('sev_' ~ a.max_severity) }}</span></td>
          <td class="n">{{ a.count }}</td>
          <td class="n">{{ a.files if a.files is not none else '—' }}</td>
          <td class="effort">
            {% set lvl = {'low': 1, 'medium': 2, 'high': 3}[a.effort] %}
            <span class="effort-bars">{% for i in range(3) %}<i class="{{ 'on' if i < lvl }}"></i>{% endfor %}</span>{{ t('effort_' ~ a.effort) }}
          </td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
      {% else %}
      <p class="muted">{{ t('no_findings') }}</p>
      {% endif %}
  </div>
</section>

{# ═══════════════════ Gráficos ═══════════════════ #}
{% if ins.exposure_total %}
<section class="section">
  <div class="grid-2">
    <div class="card">
      <div class="card-title">{{ icon('shield-alert') }} {{ t('owasp_chart') }}</div>
      {% set max_owasp = (ins.owasp_rows | map(attribute='value') | max) if ins.owasp_rows else 1 %}
      <div class="bars">
        {% for row in ins.owasp_rows %}
        <div class="bar-row" title="{{ row.label }}: {{ row.value }}">
          <div class="bar-label">{{ row.label }}</div>
          <div class="bar-track"><div class="bar-fill" style="width: {{ row.value | pct(max_owasp) }}%"></div></div>
          <div class="bar-value">{{ row.value }}</div>
        </div>
        {% else %}<p class="muted">{{ t('no_data') }}</p>
        {% endfor %}
      </div>
    </div>
    <div class="card">
      <div class="card-title">{{ icon('folder-tree') }} {{ t('files_chart') }}</div>
      {% set max_file = (ins.file_rows | map(attribute='value') | max) if ins.file_rows else 1 %}
      <div class="bars">
        {% for row in ins.file_rows %}
        <div class="bar-row">
          <div class="bar-label mono" title="{{ row.label }}">{{ row.label }}</div>
          <div class="bar-track" style="width: {{ row.value | pct(max_file) }}%">
            {% for sev, n in row.segments.items() %}
            <div class="seg sev-{{ sev }}" style="flex: {{ n }}" title="{{ t('sev_' ~ sev) }}: {{ n }}"></div>
            {% endfor %}
          </div>
          <div class="bar-value">{{ row.value }}</div>
        </div>
        {% endfor %}
      </div>
      <div class="legend">
        {% for sev in SEVERITIES %}<span class="sev-{{ sev }}"><i class="dot"></i>{{ t('sev_' ~ sev) }}</span>{% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# ═══════════════════ Amenazas ═══════════════════ #}
{% if ins.threat_total %}
<section class="section">
  <div class="section-head"><h2>{{ t('threats') }}</h2><p>{{ t('threats_help') }}</p></div>
  <div class="card">
    <div class="threat-tiles">
      <div class="tile sev-ALTA"><div class="tile-label">{{ icon('scroll-text') }} {{ t('attack_events') }}</div><div class="tile-value num">{{ ins.threat_events }}</div></div>
      <div class="tile sev-MEDIA"><div class="tile-label">{{ icon('route') }} {{ t('attacker_ips') }}</div><div class="tile-value num">{{ ins.threat_rows | length }}</div></div>
      <div class="tile sev-CRITICA"><div class="tile-label">{{ icon('octagon-alert') }} {{ t('active_attackers') }}</div><div class="tile-value num">{{ ins.active_attackers }}</div></div>
    </div>
    <div class="table-wrap">
    <table>
      <thead><tr><th>{{ t('col_ip') }}</th><th class="n">{{ t('col_events') }}</th><th>{{ t('col_attack_types') }}</th></tr></thead>
      <tbody>
      {% for r in ins.threat_rows[:8] %}
      <tr>
        <td><span class="ip">{{ r.ip }}</span>{% if r.active %}<br><span class="badge sev-CRITICA">{{ icon('octagon-alert') }} {{ t('active_attacker') }}</span>{% endif %}</td>
        <td class="n">{{ r.events }}</td>
        <td><div class="types">{% for ty in r.types %}<span class="chip">{{ ty }}</span>{% endfor %}</div></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
</section>
{% endif %}

{# ═══════════════════ Hallazgos detallados ═══════════════════ #}
{% macro finding_card(f, open=false) %}
<details class="finding sev-{{ f.severity }}" data-severity="{{ f.severity }}" data-tool="{{ f.tool }}"
         data-text="{{ (f.type ~ ' ' ~ f.path ~ ' ' ~ f.cwe ~ ' ' ~ f.tool ~ ' ' ~ f.content) | lower }}" {{ 'open' if open }}>
  <summary>
    <span class="badge sev-{{ f.severity }}">{{ icon(SEVERITY_ICON[f.severity]) }} {{ t('sev_' ~ f.severity) }}</span>
    <div>
      <div class="finding-title">{{ f.type }}</div>
      <div class="finding-loc">{{ f.path }}{% if f.line %}:{{ f.line }}{% endif %}</div>
    </div>
    <div class="finding-tags">
      {% if f.cwe %}<span class="chip">{{ f.cwe }}</span>{% endif %}
      {% if mode == 'screen' %}<span class="chev">{{ icon('chevron-down') }}</span>{% endif %}
    </div>
  </summary>
  <div class="finding-body">
    <div class="rf">
      <div><div class="field-label">{{ t('risk') }}</div><div class="field-text">{{ f.description }}</div></div>
      <div><div class="field-label">{{ t('fix') }}</div><div class="field-text">{{ f.recommendation }}</div></div>
    </div>
    {% if f.snippet %}
    <div class="full">
      <div class="field-label">{{ t('evidence') }}</div>
      <div class="code">{% for l in f.snippet if mode == 'screen' or (l.number - f.line) | abs <= 2 %}<div class="code-line {{ 'hl' if l.highlight }}"><span class="ln">{{ l.number }}</span>{{ l.text }}</div>{% endfor %}</div>
    </div>
    {% elif f.content %}
    <div class="full">
      <div class="field-label">{{ t('evidence') }}</div>
      <div class="code"><div class="code-line hl"><span class="ln">{{ f.line or '·' }}</span>{{ f.content }}</div></div>
    </div>
    {% endif %}
    <div class="full meta-line">
      {{ t('detected_by') }}: {% for tool in f.tools %}<span class="chip">{{ tool }}</span>{% endfor %}
      <span>·</span> {{ t('conf_' ~ f.confidence) }}
      {% if f.owasp %}<span>·</span> {{ f.owasp }}{% endif %}
    </div>
  </div>
</details>
{% endmacro %}

<section class="section {{ 'break' if mode == 'print' }}">
  <div class="section-head"><h2>{{ t('detailed_findings') }}</h2><p>{{ t('masked_note') }}</p></div>

  {% if not ins.entries %}
  <div class="card empty-state">{{ icon('shield-check') }}<p>{{ t('no_findings') }}</p></div>

  {% elif mode == 'screen' %}
  <div class="filters">
    <label class="search">{{ icon('search') }}<input id="q" type="search" placeholder="{{ t('search_placeholder') }}" autocomplete="off"></label>
    <div class="seg-filter" role="group">
      <button type="button" data-sev="" aria-pressed="true">{{ t('filter_all') }}</button>
      {% for sev in SEVERITIES if ins.all_severity_counts[sev] %}
      <button type="button" data-sev="{{ sev }}" aria-pressed="false" class="sev-{{ sev }}"><i class="dot"></i>{{ t('sev_' ~ sev) }} <span class="muted num">{{ ins.all_severity_counts[sev] }}</span></button>
      {% endfor %}
    </div>
    <select id="tool" aria-label="{{ t('filter_tool') }}">
      <option value="">{{ t('all_tools') }}</option>
      {% for tool in ins.tools %}<option value="{{ tool }}">{{ tool }}</option>{% endfor %}
    </select>
    <span class="count" id="count">{{ t('showing') }} {{ ins.entries | length }} / {{ ins.entries | length }}</span>
  </div>
  <div class="findings" id="findings">
    {% for f in ins.entries %}{{ finding_card(f, open=(f.severity == 'CRITICA' and not f.is_threat and loop.index <= 3)) }}{% endfor %}
  </div>

  {% else %}
  {# PDF: críticos y altos del proyecto con detalle; el resto en tablas compactas #}
  {% set major = ins.entries | selectattr('is_threat', 'false') | selectattr('severity', 'in', ['CRITICA', 'ALTA']) | list %}
  {% set minor = ins.entries | selectattr('is_threat', 'false') | selectattr('severity', 'in', ['MEDIA', 'BAJA']) | list %}
  {% set events = ins.entries | selectattr('is_threat') | list %}
  <div class="findings">{% for f in major %}{{ finding_card(f, open=true) }}{% endfor %}</div>
  {% if minor %}
  <div class="card" style="margin-top: 6mm">
    <div class="card-title">{{ icon('list-checks') }} {{ t('other_findings') }}</div>
    <table class="compact">
      <thead><tr><th>{{ t('col_sev') }}</th><th>{{ t('col_type') }}</th><th>{{ t('col_location') }}</th><th>{{ t('fix') }}</th></tr></thead>
      <tbody>{% for f in minor %}
      <tr><td><span class="badge sev-{{ f.severity }}">{{ icon(SEVERITY_ICON[f.severity]) }} {{ t('sev_' ~ f.severity) }}</span></td>
          <td>{{ f.type }}{% if f.cwe %}<br><span class="muted">{{ f.cwe }}</span>{% endif %}</td>
          <td class="mono">{{ f.path }}{% if f.line %}:{{ f.line }}{% endif %}</td>
          <td class="secondary">{{ f.recommendation }}</td></tr>
      {% endfor %}</tbody>
    </table>
  </div>
  {% endif %}
  {% if events %}
  <p class="muted" style="margin-top: 4mm">{{ t('log_events_pdf_note') }}</p>
  {% endif %}
  {% endif %}
</section>

{# ═══════════════════ Anexo: razonamiento del agente ═══════════════════ #}
<section class="section {{ 'break' if mode == 'print' }}">
  <div class="section-head"><h2>{{ t('agent_reasoning') }}</h2><p>{{ t('agent_reasoning_help') }}</p></div>
  <div class="card">
    {% if results.get('skill_used') %}<p class="meta-line" style="margin-bottom: 12px">{{ t('skill') }}: <span class="chip">{{ results.skill_used }}</span></p>{% endif %}
    <div class="phases">
      {% for key in ['observe', 'reason', 'act', 'report'] %}
      <span class="phase"><b>{{ loop.index }}</b>{{ t('phase_' ~ key) }}</span>{% if not loop.last %}<span class="phase-sep">›</span>{% endif %}
      {% endfor %}
    </div>
    {% set log_by_tool = {} %}
    {% for e in execution_log %}{% set _ = log_by_tool.update({e.tool: e}) %}{% endfor %}
    <ol class="timeline">
      {% for step in plan.get('steps', []) %}
      {% set e = log_by_tool.get(step.tool, {}) %}
      <li>
        <span class="rank">{{ step.order }}</span>
        <div><div class="step-tool">{{ step.tool }}</div><div class="step-reason">{{ step.reason }}</div></div>
        <div class="step-stats">
          {% if e.get('status') == 'success' %}<span class="ok">{{ icon('shield-check') }} {{ t('status_success') }}</span>
          {% elif e.get('status') == 'error' %}<span class="err" title="{{ e.get('error', '') }}">{{ icon('octagon-alert') }} {{ t('status_error') }}</span>{% endif %}
          <div class="num">{{ e.get('findings_count', 0) }} · {{ e.get('time_seconds', 0) }} {{ t('seconds') }}</div>
        </div>
      </li>
      {% endfor %}
    </ol>
    {% if plan.get('skipped_tools') %}
    <p class="meta-line" style="margin-top: 12px">{{ t('skipped_tools') }}: {% for s in plan.skipped_tools %}<span class="chip">{{ s }}</span>{% endfor %}</p>
    {% endif %}
  </div>
  <div class="card" style="margin-top: 16px">
    <div class="card-title">{{ icon('info') }} {{ t('methodology') }}</div>
    <p class="secondary" style="font-size: 13px">{{ t('methodology_text') }}</p>
  </div>
</section>

{% if mode == 'screen' %}<footer>{{ t('generated_by') }} v{{ version }} · {{ generated_at }}</footer>{% endif %}
</main>

{% if mode == 'screen' %}
<script>
(function () {
  var root = document.documentElement;
  var store = { get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
                set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
  var saved = store.get('secscan-theme');
  if (saved) root.setAttribute('data-theme', saved);
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var dark = root.getAttribute('data-theme') === 'dark' ||
      (!root.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    var next = dark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    store.set('secscan-theme', next);
  });

  var list = document.getElementById('findings');
  if (!list) return;
  var cards = Array.prototype.slice.call(list.children);
  var q = document.getElementById('q'), tool = document.getElementById('tool'), count = document.getElementById('count');
  var sevButtons = document.querySelectorAll('.seg-filter button');
  var sev = '';
  function apply() {
    var text = q.value.trim().toLowerCase(), shown = 0;
    cards.forEach(function (c) {
      var ok = (!sev || c.dataset.severity === sev) && (!tool.value || c.dataset.tool === tool.value) &&
               (!text || c.dataset.text.indexOf(text) !== -1);
      c.hidden = !ok; if (ok) shown++;
    });
    count.textContent = {{ t('showing') | tojson }} + ' ' + shown + ' / ' + cards.length;
  }
  sevButtons.forEach(function (b) {
    b.addEventListener('click', function () {
      sev = b.dataset.sev;
      sevButtons.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
      apply();
    });
  });
  q.addEventListener('input', apply);
  tool.addEventListener('change', apply);
  window.addEventListener('beforeprint', function () { cards.forEach(function (c) { c.open = true; }); });
})();
</script>
{% endif %}
</body>
</html>
